# Application Settings
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security / JWT
JWT_SECRET=dev-secret-key-weather-health-advisory-2026

# Google OAuth 2.0 (Optional — Demo persona login works out of the box without keys)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Database (Optional — In-memory store works out of the box if empty)
MONGO_URI=
MONGO_DB_NAME=weather_health_db

# LLM Keys (Optional — Deterministic clinical heuristic fallback works out of the box)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email Notifications (Optional — Simulated in-app notification logger active by default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS Notifications (Optional)
SMS_PROVIDER=mock
FAST2SMS_API_KEY=

# Background Scheduler
SCHEDULER_INTERVAL_MINUTES=15
